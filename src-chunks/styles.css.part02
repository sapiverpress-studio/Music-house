und:var(--orange);color:white;font-size:1.8rem;font-weight:900;margin:22px auto;box-shadow:0 10px 0 #ac6728}.tap-pad:active{transform:translateY(5px);box-shadow:0 5px 0 #ac6728}.meter{height:14px;background:#e6dac6;border-radius:999px;overflow:hidden;max-width:520px}.meter>div{height:100%;background:var(--teal);width:0;transition:width .25s}
.pulse-dots{display:flex;gap:12px;margin:20px 0;flex-wrap:wrap}.pulse-dot{width:34px;height:34px;border-radius:50%;background:#e8ddc9;border:2px solid #d2c1a5}.pulse-dot.on{background:var(--orange);border-color:#b66d28;transform:scale(1.12)}
.staff-game{background:#fff;border-radius:18px;padding:16px;overflow:auto}.staff-svg{width:100%;min-width:520px;height:auto}.staff-note{fill:var(--teal)}
.piano{display:flex;align-items:flex-start;max-width:680px;overflow:auto;padding-bottom:8px}.piano-key{position:relative;border:1px solid #6a5b4b;background:#fff;width:68px;height:210px;flex:0 0 68px;border-radius:0 0 9px 9px;display:flex;align-items:flex-end;justify-content:center;padding-bottom:12px;font-weight:900}.piano-key.black{background:#332d29;color:#fff;height:132px;width:46px;flex-basis:46px;margin:0 -23px;z-index:2;border-radius:0 0 7px 7px;padding-bottom:8px}.piano-key.active{background:var(--orange2)}.piano-key.black.active{background:var(--teal)}
.triad-notes{display:flex;gap:12px;flex-wrap:wrap}.triad-note{width:58px;height:58px;border-radius:50%;border:2px solid var(--line);background:white;font-weight:900;font-size:1.2rem}.triad-note.selected{background:var(--teal);color:white;border-color:var(--teal)}
.maker-layout{display:grid;grid-template-columns:280px 1fr;gap:20px}.maker-tools{display:flex;flex-direction:column;gap:16px}.tool-card,.composer-card,.dashboard-card{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:20px}.unlock-list{display:flex;flex-direction:column;gap:9px}.unlock-row{display:flex;align-items:center;gap:10px;font-size:.92rem}.unlock-icon{width:28px;height:28px;border-radius:50%;display:grid;place-items:center;background:#ebe1ce;font-weight:900}.unlock-row.on .unlock-icon{background:var(--teal);color:white}.tool-card input[type=range]{width:100%}.composer-head{display:flex;justify-content:space-between;gap:16px;align-items:start}.hint{font-size:.82rem;color:var(--muted);font-weight:700}.composer-grid{display:grid;grid-template-columns:repeat(8,1fr);gap:7px;margin:18px 0}.beat-cell{aspect-ratio:1/1.15;border:2px solid var(--line);border-radius:13px;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:3px;font-weight:900;min-width:0}.beat-cell.current{outline:4px solid var(--orange2);border-color:var(--orange)}.beat-cell .beat-n{font-size:.7rem;color:var(--muted)}.beat-cell .note-n{font-size:1.25rem}.composer-notes{display:flex;gap:8px;flex-wrap:wrap}.note-button{width:46px;height:46px;border-radius:50%;border:0;background:var(--teal2);font-weight:900}.note-button.rest{border-radius:12px;background:#ece4d5}.note-button.active{background:var(--teal);color:#fff}
.grownup-grid{display:grid;grid-template-columns:1.1fr .9fr;gap:20px}.progress-row{display:grid;grid-template-columns:1fr auto;gap:10px;align-items:center;padding:10px 0;border-bottom:1px solid var(--line)}.progress-row:last-child{border:0}.progress-row small{display:block;color:var(--muted)}.grownup-steps{padding-left:22px}.grownup-steps li{margin-bottom:10px}
footer{display:flex;justify-content:space-between;gap:20px;flex-wrap:wrap;padding:30px clamp(18px,4vw,52px);background:var(--paper);border-top:1px solid var(--line);color:var(--muted)}
@media (max-width:920px){.hero,.lesson-hero,.maker-layout,.grownup-grid{grid-template-columns:1fr}.room-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.hero-art{max-width:650px}.maker-tools{display:grid;grid-template-columns:1fr 1fr}.composer-grid{grid-template-columns:repeat(4,1fr)}}
@media (max-width:620px){.site-header nav{display:none}.hero{padding-top:36px}.room-grid{grid-template-columns:1fr}.maker-tools{grid-template-columns:1fr}.composer-head{display:block}.composer-grid{grid-template-columns:repeat(4,1fr)}.progress-summary{gap:18px}.mode-panel{padding:18px}.lesson-intro{padding:21px}}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important}}

/* Multi-page refinements */
html{scroll-behavior:auto}
.site-header nav a.active{color:var(--teal);position:relative}
.site-header nav a.active::after{content:"";position:absolute;left:0;right:0;bottom:-7px;height:3px;border-radius:999px;background:var(--orange)}
.page-hero{max-width:1260px;margin:auto;padding:62px clamp(18px,4vw,52px) 18px}
.page-hero.compact{padding-bottom:4px}.page-hero p{max-width:760px;color:var(--muted);font-size:1.08rem}
.page-hero h1{font-size:clamp(2.8rem,6vw,5.5rem)}
.home-room-section{padding-top:34px}.section-actions{display:flex;justify-content:center;margin-top:28px}
.lesson-page{padding-top:30px}.lesson-title{font-size:clamp(2.6rem,5vw,4.8rem);margin:.12em 0 .22em}
.breadcrumbs{display:flex;gap:8px;flex-wrap:wrap;color:var(--muted);font-size:.88rem;font-weight:800;margin:0 0 20px}.breadcrumbs a{text-decoration:none;color:var(--teal)}
.chapter-nav{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:14px;margin-top:20px}.chapter-nav>a:last-child{justify-self:end}.chapter-nav .text-link{font-weight:900;color:var(--teal);text-decoration:none}
.nav-home{display:none}
.intro-card-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px}.intro-card{background:var(--paper);border:1px solid var(--line);border-radius:22px;padding:22px}.intro-card .big-icon{font-size:2rem}.intro-card p{color:var(--muted)}
@media(max-width:720px){
  .site-header{align-items:flex-start;flex-direction:column;gap:10px}.site-header nav{display:flex!important;width:100%;gap:8px;overflow-x:auto;padding-bottom:4px}.site-header nav a{white-space:nowrap;background:#f3ead9;padding:8px 10px;border-radius:10px;font-size:.87rem}.site-header nav a.ac