:root{
  --cream:#f5eddc;--paper:#fffaf0;--paper2:#fff6e5;--ink:#302821;--muted:#6f6256;
  --teal:#2e7774;--teal2:#d8ebe7;--orange:#d78631;--orange2:#f6dfbb;--coral:#b85b43;
  --olive:#6d7650;--line:#ddceb3;--shadow:0 16px 40px rgba(71,49,28,.10);
  --radius:24px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--cream);color:var(--ink);line-height:1.55}
button,input,select{font:inherit}button{cursor:pointer}a{color:inherit}
.site-header{position:sticky;top:0;z-index:50;display:flex;align-items:center;justify-content:space-between;gap:24px;padding:14px clamp(18px,4vw,52px);background:rgba(255,250,240,.94);backdrop-filter:blur(14px);border-bottom:1px solid var(--line)}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font-weight:900}.brand-mark{display:grid;place-items:center;width:38px;height:38px;border-radius:50%;background:var(--teal);color:white;font-size:1.2rem}
nav{display:flex;gap:20px}nav a{text-decoration:none;font-weight:800;color:var(--muted)}nav a:hover{color:var(--teal)}
.hero{max-width:1260px;margin:auto;padding:64px clamp(18px,4vw,52px) 40px;display:grid;grid-template-columns:1.02fr .98fr;gap:52px;align-items:center}
.eyebrow{margin:0 0 8px;text-transform:uppercase;letter-spacing:.11em;font-size:.78rem;font-weight:900;color:var(--teal)}
h1,h2,h3{font-family:Georgia,"Times New Roman",serif;line-height:1.06}h1{font-size:clamp(3rem,7vw,6.2rem);margin:.08em 0 .18em;max-width:850px}h2{font-size:clamp(2.25rem,5vw,4.1rem);margin:.1em 0 .25em}h3{font-size:1.48rem;margin:.15em 0 .55em}.lede{font-size:clamp(1.08rem,2vw,1.35rem);max-width:680px;color:var(--muted)}
.hero-actions,.inline-actions{display:flex;gap:10px;flex-wrap:wrap}.hero-actions{margin:28px 0 30px}.button{border:0;border-radius:14px;padding:13px 18px;font-weight:900;text-decoration:none;display:inline-flex;align-items:center;justify-content:center}.button.primary{background:var(--teal);color:white}.button.secondary{background:var(--orange2);color:var(--ink);border:1px solid #e4bf83}.button.small{padding:10px 13px;border-radius:11px}
.hero-art{margin:0;background:var(--paper);padding:12px;border-radius:28px;box-shadow:var(--shadow);transform:rotate(1deg)}.hero-art img{width:100%;display:block;border-radius:19px}.hero-art figcaption{padding:11px 8px 5px;text-align:center;color:var(--muted);font-size:.92rem;font-weight:700}
.progress-summary{display:flex;gap:28px;flex-wrap:wrap}.progress-summary div{display:flex;flex-direction:column}.progress-summary strong{font-size:1.45rem}.progress-summary span{font-size:.82rem;color:var(--muted);font-weight:700}
.section{padding:76px clamp(18px,4vw,52px);max-width:1260px;margin:auto}.section-heading{max-width:820px;margin-bottom:32px}.section-heading>p:last-child{font-size:1.08rem;color:var(--muted)}
.room-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}.room-card{background:var(--paper);border:1px solid var(--line);border-radius:var(--radius);overflow:hidden;box-shadow:0 8px 24px rgba(71,49,28,.06);display:flex;flex-direction:column}.room-card img{width:100%;aspect-ratio:16/10;object-fit:cover;object-position:center 32%}.room-body{padding:20px;display:flex;flex:1;flex-direction:column}.room-num{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:.78rem;text-transform:uppercase;letter-spacing:.08em;font-weight:900;color:var(--coral)}.status-chip{font-size:.73rem;text-transform:none;letter-spacing:0;border-radius:999px;padding:5px 9px;background:#eee4d2;color:var(--muted)}.status-chip.confident{background:var(--teal2);color:#225d5a}.status-chip.practising{background:var(--orange2);color:#87531d}.room-card h3{font-size:1.55rem}.room-card p{color:var(--muted);margin-top:0}.room-card .button{margin-top:auto;width:100%}
.lesson-shell{padding-top:42px}.lesson-topbar{display:flex;justify-content:space-between;align-items:center;margin-bottom:18px}.text-button{border:0;background:none;padding:8px 0;font-weight:900;color:var(--teal)}.lesson-status{font-size:.8rem;font-weight:900;padding:7px 11px;border-radius:999px;background:var(--teal2);color:#235e5b}
.lesson-hero{display:grid;grid-template-columns:.95fr 1.05fr;gap:26px;align-items:stretch;margin-bottom:24px}.lesson-art{background:var(--paper);padding:10px;border:1px solid var(--line);border-radius:24px}.lesson-art img{display:block;width:100%;height:100%;max-height:520px;object-fit:cover;border-radius:16px}.lesson-intro{background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:28px;display:flex;flex-direction:column;justify-content:center}.chapter-label{font-size:.82rem;font-weight:900;color:var(--coral);text-transform:uppercase;letter-spacing:.08em}.lesson-intro p{color:var(--muted);font-size:1.06rem}.concept-box{background:var(--orange2);border-radius:16px;padding:14px 16px;margin-top:8px;font-weight:800}
.mode-tabs{display:flex;gap:8px;flex-wrap:wrap;margin:18px 0}.mode-tab{border:1px solid var(--line);background:var(--paper);padding:10px 14px;border-radius:999px;font-weight:900}.mode-tab.active{background:var(--teal);color:#fff;border-color:var(--teal)}.mode-panel{background:var(--paper);border:1px solid var(--line);border-radius:24px;padding:26px;min-height:300px}.mode-panel p{max-width:780px}.hear-card,.practice-card{background:var(--paper2);border:1px dashed #d3b885;border-radius:18px;padding:18px;margin-top:14px}.large-action{font-size:1.15rem;padding:16px 22px}.feedback{font-weight:800;color:var(--teal);min-height:1.6em}.choice-row{display:flex;gap:10px;flex-wrap:wrap;margin:14px 0}.choice{min-width:74px;min-height:52px;border:2px solid var(--line);border-radius:14px;background:#fff;font-weight:900;font-size:1.05rem}.choice:hover,.choice.selected{border-color:var(--teal);background:var(--teal2)}
.tap-pad{display:grid;place-items:center;width:min(260px,75vw);aspect-ratio:1;border-radius:50%;border:0;backgro