tive::after{display:none}.brand-mark{width:34px;height:34px}.chapter-nav{grid-template-columns:1fr 1fr}.chapter-nav .text-link{grid-column:1/-1;grid-row:1;text-align:center}.chapter-nav>a:last-child{justify-self:stretch}.chapter-nav>a:first-child{justify-self:stretch}.intro-card-grid{grid-template-columns:1fr}.page-hero{padding-top:38px}
}

/* Music House interactive keyboard */
.keyboard-hero{max-width:1000px}.keyboard-section{max-width:1100px}.keyboard-card{background:var(--paper);border:1px solid var(--line);border-radius:28px;padding:clamp(18px,4vw,34px);box-shadow:var(--shadow)}
.mastery-card{margin-top:16px}.signature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.signature-grid>div{display:flex;flex-direction:column;gap:4px;padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}.signature-grid span{color:var(--muted);font-size:.92rem}
.keyboard-mode-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.keyboard-controls{max-width:920px;margin:0 auto 12px;display:grid;grid-template-columns:1fr 1fr;gap:16px;align-items:center}.volume-control{display:grid;grid-template-columns:1fr auto;gap:6px 14px;align-items:center}.volume-control input{grid-column:1/-1;width:100%;min-height:32px;accent-color:var(--teal)}.sustain-control{display:flex;gap:12px;align-items:center;min-height:48px}.sustain-control input{width:24px;height:24px;accent-color:var(--teal)}.sustain-control small{display:block;color:var(--muted);margin-top:3px}.volume-note,.keyboard-help{max-width:920px;margin:7px auto 12px;color:var(--muted);font-size:.9rem}.keyboard-help{color:var(--ink);font-weight:700}.interactive-keyboard{position:relative;max-width:920px;margin:0 auto 18px;height:300px;user-select:none;-webkit-user-select:none;touch-action:none}.keyboard-whites{display:grid;grid-template-columns:repeat(8,1fr);height:100%}.music-key{font:inherit;cursor:pointer;transition:transform .08s,background .12s;touch-action:none;-webkit-user-select:none;user-select:none}.white-key{border:1px solid #8b7b69;border-right-width:0;background:#fffaf1;color:var(--ink);display:flex;align-items:flex-end;justify-content:center;padding:0 0 18px;font-weight:900;font-size:1.05rem;border-radius:0 0 10px 10px}.white-key:last-child{border-right-width:1px}.black-key{position:absolute;top:0;width:46px;height:185px;background:#302a25;color:white;border:1px solid #1c1815;border-radius:0 0 8px 8px;z-index:3;display:flex;align-items:flex-end;justify-content:center;padding-bottom:12px;font-size:.78rem;font-weight:900}.music-key.pressed{transform:translateY(4px);background:var(--orange2)}.black-key.pressed{background:var(--teal)}.music-key.selected{box-shadow:inset 0 0 0 5px var(--teal);background:var(--teal2);color:var(--ink)}.black-key.selected{background:var(--teal);color:#fff;box-shadow:inset 0 0 0 3px #fff}.keyboard-feedback{min-height:2em;text-align:center;font-size:1.08rem;font-weight:900;color:var(--teal);margin:14px auto 20px}.keyboard-feedback.good{color:#246447}.keyboard-game-controls{max-width:780px;margin:0 auto;background:var(--paper2);border:1px dashed #d3b885;border-radius:18px;padding:18px}.keyboard-game-controls p{margin-top:0}.keyboard-game-controls .inline-actions{justify-content:center}
@media(max-width:720px){.interactive-keyboard{height:230px}.black-key{width:34px;height:142px;margin-left:6px}.white-key{font-size:.9rem;padding-bottom:12px}.keyboard-mode-tabs{display:grid;grid-template-columns:1fr 1fr}.keyboard-mode-tabs .mode-tab:last-child{grid-column:1/-1}}
@media(max-width:520px){.keyboard-controls{grid-template-columns:1fr;gap:8px}.volume-control input{min-height:40px}.signature-grid{grid-template-columns:1fr}}
@media(max-width:430px){.interactive-keyboard{height:205px}.black-key{width:30px;height:126px}.white-key{font-size:.8rem}.keyboard-card{padding:14px}.keyboard-mode-tabs{grid-template-columns:1fr}}
