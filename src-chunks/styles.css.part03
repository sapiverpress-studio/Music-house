tive::after{display:none}.brand-mark{width:34px;height:34px}.chapter-nav{grid-template-columns:1fr 1fr}.chapter-nav .text-link{grid-column:1/-1;grid-row:1;text-align:center}.chapter-nav>a:last-child{justify-self:stretch}.chapter-nav>a:first-child{justify-self:stretch}.intro-card-grid{grid-template-columns:1fr}.page-hero{padding-top:38px}
}

/* Music House interactive keyboard */
.keyboard-hero{max-width:1000px}.keyboard-section{max-width:1100px}.keyboard-card{background:var(--paper);border:1px solid var(--line);border-radius:28px;padding:clamp(18px,4vw,34px);box-shadow:var(--shadow)}
.mastery-card{margin-top:16px}.signature-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px;margin:14px 0}.signature-grid>div{display:flex;flex-direction:column;gap:4px;padding:13px;border:1px solid var(--line);border-radius:14px;background:var(--paper)}.signature-grid span{color:var(--muted);font-size:.92rem}
.keyboard-mode-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}
.piano-console{max-width:960px;margin:0 auto 16px;padding:18px 18px 20px;border:1px solid #11100f;border-radius:22px;background:linear-gradient(180deg,#373432 0%,#242220 55%,#181715 100%);box-shadow:0 18px 34px rgba(34,28,22,.24),inset 0 1px 0 rgba(255,255,255,.08);color:#f7f1e8}
.piano-console-head{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:0 4px 12px;border-bottom:1px solid rgba(255,255,255,.12);letter-spacing:.04em}.piano-wordmark{font-weight:900}.piano-model{font-size:.78rem;text-transform:uppercase;color:#cfc5b8;letter-spacing:.13em}
.piano-fullscreen-button{min-height:44px;padding:7px 15px;border:1px solid #dfc9a7;border-radius:10px;background:#ede0ca;color:#221e19;font-weight:800;white-space:nowrap}.piano-fullscreen-button:focus-visible{outline:3px solid #fff;outline-offset:3px}
.keyboard-controls{margin:14px auto 8px;display:grid;grid-template-columns:1fr 1fr;gap:18px;align-items:center}.volume-control{display:grid;grid-template-columns:1fr auto;gap:6px 14px;align-items:center}.volume-control input{grid-column:1/-1;width:100%;min-height:32px;accent-color:var(--orange2)}.sustain-control{display:flex;gap:12px;align-items:center;min-height:48px}.sustain-control input{width:24px;height:24px;accent-color:var(--orange2)}.sustain-control small{display:block;color:#cfc5b8;margin-top:3px}.volume-note{margin:6px 0 14px;color:#cfc5b8;font-size:.86rem}.keyboard-help{max-width:920px;margin:9px auto 12px;color:var(--ink);font-weight:700;font-size:.9rem}
.piano-keybed{padding:0 8px 10px;border:1px solid #0b0a09;border-radius:12px;background:#11100f;box-shadow:inset 0 2px 8px rgba(0,0,0,.65),0 2px 0 rgba(255,255,255,.08)}.piano-felt{height:7px;margin:0 -1px 1px;background:linear-gradient(180deg,#a34642,#742b29);box-shadow:0 1px 2px rgba(0,0,0,.55)}
.interactive-keyboard{position:relative;width:100%;margin:0;height:300px;user-select:none;-webkit-user-select:none;touch-action:none;--white-count:8;--black-width:7.25%}.keyboard-whites{display:grid;grid-template-columns:repeat(var(--white-count),minmax(0,1fr));height:100%}.music-key{font:inherit;cursor:pointer;transition:transform .08s,background .12s,box-shadow .12s;touch-action:none;-webkit-user-select:none;user-select:none}.white-key{min-width:0;border:1px solid #8b8176;border-right-width:0;background:linear-gradient(90deg,#fffdfa 0%,#f5efe7 78%,#e8dfd4 100%);color:#3c342d;display:flex;align-items:flex-end;justify-content:center;padding:0 0 15px;font-weight:900;font-size:.96rem;border-radius:0 0 5px 5px;box-shadow:inset 0 -8px 12px rgba(117,96,72,.08)}.white-key:last-child{border-right-width:1px}.white-key span{display:inline-flex;align-items:center;justify-content:center;min-width:24px;height:24px;padding:0 5px;border-radius:999px;background:rgba(255,255,255,.76);box-shadow:0 1px 2px rgba(57,48,39,.12)}
.black-key{position:absolute;top:0;transform:translateX(-50%);width:var(--black-width);height:62%;background:linear-gradient(90deg,#121110 0%,#3a3734 48%,#151412 100%);color:#f8f3eb;border:1px solid #090807;border-radius:0 0 6px 6px;z-index:3;display:flex;align-items:flex-end;justify-content:center;padding:0 0 10px;font-size:.7rem;font-weight:900;box-shadow:0 5px 8px rgba(0,0,0,.52),inset 0 -7px 9px rgba(255,255,255,.035)}.black-key span{opacity:.82}
.music-key.pressed{transform:translateY(3px);background:var(--orange2)}.black-key.pressed{transform:translateX(-50%) translateY(3px);background:var(--teal)}.music-key.selected{box-shadow:inset 0 0 0 5px var(--teal);background:var(--teal2);color:var(--ink)}.black-key.selected{background:var(--teal);color:#fff;box-shadow:inset 0 0 0 3px #fff,0 5px 8px rgba(0,0,0,.45)}
.keyboard-feedback{min-height:2em;text-align:center;font-size:1.08rem;font-weight:900;color:var(--teal);margin:14px auto 20px}.keyboard-feedback.good{color:#246447}.keyboard-game-controls{max-width:780px;margin:0 auto;background:var(--paper2);border:1px dashed #d3b885;border-radius:18px;padding:18px}.keyboard-game-controls p{margin-top:0}.keyboard-game-controls .inline-actions{justify-content:center}
.piano-console .keyboard-feedback{color:#f5e9cf;margin:10px 0 0;min-height:1.5em}.piano-console .keyboard-feedback.good{color:#bce9ba}
body.keyboard-immersive{overflow:hidden}.piano-console.immersive{position:fixed;inset:0;z-index:1000;width:100%;height:100vh;height:100dvh;max-width:none;margin:0;padding:max(8px,env(safe-area-inset-top)) max(10px,env(safe-area-inset-right)) max(8px,env(safe-area-inset-bottom)) max(10px,env(safe-area-inset-left));border-radius:0;display:flex;flex-direction:column;overflow:hidden}.piano-console.immersive .piano-console-head{flex:none;min-height:42px;padding-bottom:4px}.piano-console.immersive .keyboard-controls{flex:none;margin:5px 0;gap:8px}.piano-console.immersive .sustain-control small,.piano-console.immersive .piano-model,.piano-console.immersive .volume-note{display:none}.piano-console.immersive .piano-keybed{display:flex;flex:1;flex-direction:column;min-height:0}.piano-console.immersive .piano-felt{flex:none}.piano-console.immersive .interactive-keyboard{flex:1;height:auto;min-height:0}.piano-console.immersive .keyboard-feedback{flex:none;margin:3px 0 0;font-size:.86rem;min-height:1.3em}
@media(max-width:720px){.piano-console{padding:14px 12px 14px}.interactive-keyboard{height:230px}.white-key{font-size:.84rem;padding-bottom:11px}.white-key span{min-width:21px;height:21px;padding:0 4px}.black-key{height:62%;font-size:.62rem;padding-bottom:8px}.keyboard-mode-tabs{display:grid;grid-template-columns:1fr 1fr}.keyboard-mode-tabs .mode-tab:last-child{grid-column:1/-1}}
@media(max-width:520px){.keyboard-controls{grid-template-columns:1fr;gap:8px}.volume-control input{min-height:40px}.signature-grid{grid-template-columns:1fr}.piano-console-head{align-items:flex-start;flex-direction:column;gap:4px}}
@media(max-width:430px){.interactive-keyboard{height:205px}.white-key{font-size:.78rem}.black-key span{display:none}.keyboard-card{padding:14px}.keyboard-mode-tabs{grid-template-columns:1fr}.piano-keybed{padding-left:5px;padding-right:5px}}
@media(orientation:landscape) and (max-height:520px){.interactive-keyboard{height:210px}.piano-console{padding-top:12px}.keyboard-controls{margin-top:10px}.piano-console-head{padding-bottom:8px}.white-key span{font-size:.72rem;min-width:20px;height:20px}.black-key span{font-size:.56rem}}
@media(orientation:landscape) and (max-height:520px){.piano-console.immersive .piano-console-head{flex-direction:row;align-items:center}.piano-console.immersive .keyboard-controls{grid-template-columns:minmax(0,1fr) minmax(0,1fr)}.piano-console.immersive .piano-fullscreen-button{min-height:38px}.piano-console.immersive .volume-control input{min-height:24px}}
