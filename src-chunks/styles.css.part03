tive::after{display:none}.brand-mark{width:34px;height:34px}.chapter-nav{grid-template-columns:1fr 1fr}.chapter-nav .text-link{grid-column:1/-1;grid-row:1;text-align:center}.chapter-nav>a:last-child{justify-self:stretch}.chapter-nav>a:first-child{justify-self:stretch}.intro-card-grid{grid-template-columns:1fr}.page-hero{padding-top:38px}
}

/* Music House interactive keyboard */
.keyboard-hero{max-width:1000px}.keyboard-section{max-width:1100px}.keyboard-card{background:var(--paper);border:1px solid var(--line);border-radius:28px;padding:clamp(18px,4vw,34px);box-shadow:var(--shadow)}
.keyboard-mode-tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:24px}.interactive-keyboard{position:relative;max-width:920px;margin:0 auto 18px;height:300px;user-select:none;touch-action:manipulation}.keyboard-whites{display:grid;grid-template-columns:repeat(8,1fr);height:100%}.music-key{font:inherit;cursor:pointer;transition:transform .08s,background .12s}.white-key{border:1px solid #8b7b69;border-right-width:0;background:#fffaf1;color:var(--ink);display:flex;align-items:flex-end;justify-content:center;padding:0 0 18px;font-weight:900;font-size:1.05rem;border-radius:0 0 10px 10px}.white-key:last-child{border-right-width:1px}.black-key{position:absolute;top:0;width:46px;height:185px;background:#302a25;color:white;border:1px solid #1c1815;border-radius:0 0 8px 8px;z-index:3;display:flex;align-items:flex-end;justify-content:center;padding-bottom:12px;font-size:.78rem;font-weight:900}.music-key.pressed{transform:translateY(4px);background:var(--orange2)}.black-key.pressed{background:var(--teal)}.music-key.selected{box-shadow:inset 0 0 0 5px var(--teal);background:var(--teal2);color:var(--ink)}.black-key.selected{background:var(--teal);color:#fff;box-shadow:inset 0 0 0 3px #fff}.keyboard-feedback{min-height:2em;text-align:center;font-size:1.08rem;font-weight:900;color:var(--teal);margin:14px auto 20px}.keyboard-feedback.good{color:#246447}.keyboard-game-controls{max-width:780px;margin:0 auto;background:var(--paper2);border:1px dashed #d3b885;border-radius:18px;padding:18px}.keyboard-game-controls p{margin-top:0}.keyboard-game-controls .inline-actions{justify-content:center}
@media(max-width:720px){.interactive-keyboard{height:230px}.black-key{width:34px;height:142px;margin-left:6px}.white-key{font-size:.9rem;padding-bottom:12px}.keyboard-mode-tabs{display:grid;grid-template-columns:1fr 1fr}.keyboard-mode-tabs .mode-tab:last-child{grid-column:1/-1}}
@media(max-width:430px){.interactive-keyboard{height:205px}.black-key{width:30px;height:126px}.white-key{font-size:.8rem}.keyboard-card{padding:14px}.keyboard-mode-tabs{grid-template-columns:1fr}}
