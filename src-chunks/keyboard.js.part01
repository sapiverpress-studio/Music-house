(() => {
  const lowerNaturals = ['C4','D4','E4','F4','G4','A4','B4','C5'];
  const fullNaturals = ['C4','D4','E4','F4','G4','A4','B4','C5','D5','E5','F5','G5','A5','B5','C6'];
  const blackKeys = [
    ['C#4','C4'],['D#4','D4'],['F#4','F4'],['G#4','G4'],['A#4','A4'],
    ['C#5','C5'],['D#5','D5'],['F#5','F5'],['G#5','G5'],['A#5','A5']
  ];
  const state = {mode:'free',target:null,pair:null,selected:[]};
  const heldPointers = new Map(), activePointers = new Set(), sustained = new Set();
  const rangeMedia = window.matchMedia?.('(orientation: landscape), (min-width: 900px)');
  let noteSerial=0, renderedExpanded=null;

  let audioCtx=null, masterGain=null, limiter=null;
  const activeVoices = new Map();
  let volumeLevel = Math.max(.55,Math.min(1.8,Number(localStorage.getItem('music-house-volume'))||1.35));

  function labelFor(note){return String(note).replace(/\d+$/,'').replace('#','♯');}
  function frequencyFor(note){
    const match=/^([A-G])(#?)(\d)$/.exec(String(note));
    if(!match)return null;
    const semitone={C:0,D:2,E:4,F:5,G:7,A:9,B:11}[match[1]]+(match[2]?1:0);
    const midi=(Number(match[3])+1)*12+semitone;
    return 440*Math.pow(2,(midi-69)/12);
  }
  function ctx(){
    if(!audioCtx){
      const Audio=window.AudioContext||window.webkitAudioContext;if(!Audio)return null;
      audioCtx=new Audio();masterGain=audioCtx.createGain();limiter=audioCtx.createDynamicsCompressor();
      limiter.threshold.value=-12;limiter.knee.value=18;limiter.ratio.value=6;limiter.attack.value=.004;limiter.release.value=.22;
      masterGain.gain.value=volumeLevel;masterGain.connect(limiter);limiter.connect(audioCtx.destination);
    }
    if(audioCtx.state==='suspended')audioCtx.resume();
    return audioCtx;
  }
  function makeVoice(note,when,vol){
    const a=ctx(),freq=frequencyFor(note);if(!a||!freq)return null;
    const parts=[[1,1],[2,.32],[3,.12]],nodes=[];
    for(const [multiple,level] of parts){
      const osc=a.createOscillator(),gain=a.createGain();osc.type='sine';osc.frequency.value=freq*multiple;
      gain.gain.setValueAtTime(.0001,when);gain.gain.exponentialRampToValueAtTime(Math.max(.0001,vol*level),when+.018);
      osc.connect(gain);gain.connect(masterGain);osc.start(when);nodes.push({osc,gain});
    }
    return {nodes};
  }
  function releaseVoice(voice,when){
    if(!voice||!audioCtx)return;const releaseAt=when??audioCtx.currentTime,end=releaseAt+.16;
    voice.nodes.forEach(({osc,gain})=>{gain.gain.cancelScheduledValues(releaseAt);gain.gain.setTargetAtTime(.0001,releaseAt,.045);osc.stop(end+.04);});
  }
  const audio={
    start(note,id,vol=.28){const a=ctx();if(!a)return;if(activeVoices.has(id))releaseVoice(activeVoices.get(id));const voice=makeVoice(note,a.currentTime,vol);if(voice)activeVoices.set(id,voice);},
    stop(id){const voice=activeVoices.get(id);if(!voice)return;activeVoices.delete(id);releaseVoice(voice);},
    play(note,vol=.16,duration=.4,delay=0){const a=ctx();if(!a)return;const when=a.currentTime+delay,voice=makeVoice(note,when,vol);if(voice)releaseVoice(voice,when+Math.max(.05,duration-.11));},
    setVolume(value){volumeLevel=Math.max(.55,Math.min(1.8,Number(value)||1.35));localStorage.setItem('music-house-volume',String(volumeLevel));if(masterGain&&audioCtx)masterGain.gain.setTargetAtTime(volumeLevel,audioCtx.currentTime,.03);}
  };

  function setFeedback(text,good=false){const el=document.querySelector('#keyboardFeedback');if(el){el.textContent=text;el.classList.toggle('good',good);}}
  function clearActive(){document.querySelectorAll('.music-key').forEach(k=>k.classList.remove('target','selected'));}
  function cue(note,duration=.4,delay=0){audio.play(note,.16,duration,delay);}
  function stopAll(){
    heldPointers.forEach(({id})=>audio.stop(id));heldPointers.clear();
    activePointers.clear();
    sustained.forEach(id=>audio.stop(id));sustained.clear();
    document.querySelectorAll('.music-key').forEach(k=>k.classList.remove('pressed'));
  }
  function showPressed(note){
    document.querySelectorAll('.music-key').forEach(key=>{
      if(key.dataset.note===note)key.classList.toggle('pressed',[...heldPointers.values()].some(held=>held.note===note));
    });
  }
  function releaseHeld(pointerId,allowSustain=true){
    const held=heldPointers.get(pointerId);if(!held)return;
    heldPointers.delete(pointerId);showPressed(held.note);
    if(allowSustain&&document.querySelector('#sustainToggle')?.checked)sustained.add(held.id);
    else audio.stop(held.id);
  }
  function pressKey(pointerId,key){
    const note=key.dataset.note;
    if(heldPointers.get(pointerId)?.note===note)return;
    releaseHeld(pointerId);
    const id=`keyboard-${pointerId}-${++noteSerial}`;
    heldPointers.set(pointerId,{id,note});showPressed(note);
    audio.start(note,id,.28);handleKey(note,true);
  }
  function keyAtPoint(shell,event){
    const key=document.elementFromPoint(event.clientX,event.clientY)?.closest('.music-key');
    return key&&shell.contains(key)?key:null;
  }
  function shouldExpand(){return Boolean(rangeMedia?.matches);}
  function buildKeyboard(){
    const shell=document.querySelector('#interactiveKeyboard');if(!shell)return;
    const expanded=shouldExpand();if(renderedExpanded===expanded&&shell.children.length)return;
    stopAll();renderedExpanded=expanded;shell.innerHTML='';
    const naturals=expanded?fullNaturals:lowerNaturals;
    shell.dataset.range=expanded?'two-octave':'one-octave';
    shell.setAttribute('aria-label',expanded?'Two octave touch piano keyboard, C4 to C6':'One octave touch piano keyboard, C4 to C5');
    shell.style.setProperty('--white-count',String(naturals.length));
    shell.style.setProperty('--black-width',`${(100/naturals.length)*.58}%`);

    const white=document.createElement('div');white.className='keyboard-whites';
    naturals.forEach(note=>{
      const b=document.createElement('button');b.type='button';b.className='music-key white-key';b.dataset.note=note;
      b.innerHTML=`<span>${labelFor(note)}</span>`;b.setAttribute('aria-label',`Play ${labelFor(note)}, octave ${note.slice(-1)}`);white.appendChild(b);
    });
    shell.appendChild(white);

    blackKeys.forEach(([note,after])=>{
      const afterIndex=naturals.indexOf(after);if(afterIndex<0||afterIndex>=naturals.length-1)return;
      const b=document.createElement('button');b.type='button';b.className='music-key black-key';b.dataset.note=note;
      b.innerHTML=`<span>${labelFor(note)}</span>`;b.setAttribute('aria-label',`Play ${labelFor(note)}, octave ${note.slice(-1)}`);
      b.style.left=`${((afterIndex+1)/naturals.length)*100}%`;shell.appendChild(b);
    });

    shell.querySelectorAll('.music-key').forEach(b=>{
      if(state.selected.includes(b.dataset.note))b.classList.add('selected');
    });
  }

  function setupPointerPlaying(){
    const shell=document.querySelector('#interactiveKeyboard');if(!shell)return;
    shell.addEventListener('pointerdown',event=>{
      const key=keyAtPoint(shell,event);if(!key)return;
      event.preventDefault();activePointers.add(event.pointerId);shell.setPointerCapture?.(event.pointerId);
      pressKey(event.pointerId,key);
    });
    shell.addEventListener('pointermove',event=>{
      if(!activePointers.has(event.pointerId))return;
      event.preventDefault();const key=keyAtPoint(shell,event);
      if(key)pressKey(event.pointerId,key);else releaseHeld(event.pointerId);
    });
    const finish=(event,allowSustain)=>{activePointers.delete(event.pointerId);releaseHeld(event.pointerId,allowSustain);};
    shell.addEventListener('pointerup',event=>finish(event,true));
    shell.addEventListener('pointercancel',event=>finish(event,false));
    shell.addEventListener('lostpointercapture',event=>finish(event,false));
    shell.addEventListener('click',event=>{
      const key=event.target.closest('.music-key');
      if(key&&event.detail===0){cue(key.dataset.note,.55);handleKey(key.dataset.note,true);}
    });
  }

  function setupFullscreen(){
    const consoleEl=document.querySelector('.piano-console'),button=document.querySelector('#pianoFullscreen');
    if(!consoleEl||!button)return;
    const sync=active=>{
      consoleEl.classList.toggle('immersive',active);
      document.body.classList.toggle('keyboard-immersive',active);
      button.setAttribute('aria-pressed',String(active));
      button.textContent=active?'Exit full screen':'Full screen';
    };
    button.addEventListener('click',async()=>{
      if(consoleEl.classList.contains('immersive')){
        if(document.fullscreenElement===consoleEl){try{await document.exitFullscreen();}catch{}}
        sync(false);return;
      }
      sync(true);
      if(consoleEl.requestFullscreen){try{await consoleEl.requestFullscreen();}catch{/* Screen-filling layout remains available. */}}
    });
    document.addEventListener('fullscreenchange',()=>{
      if(document.fullscreenElement===consoleEl)sync(true);
      else if(consoleEl.classList.contains('immersive'))sync(false);
    });
    document.addEventListener('keydown',event=>{
      if(event.key==='Escape'&&consoleEl.classList.contains('immersive')&&!document.fullscreenElement)sync(false);
    });
  }

  function modeFree(){stopAll();state.mode='free';state.target=null;state.pair=null;state.selected=[];clearActive();setFeedback('Free play: press and hold any key to sustain its sound.');}
  function modeFind(){stopAll();state.mode='find';state.selected=[];clearActive();newFind();}
  function newFind(){state.target=lowerNaturals[Math.floor(Math.random()*7)];setFeedback(`Find ${labelFor(state.target)}. Press its key.`);}
  function modeMovement(){stopAll();state.mode='movement';state.selected=[];clearActive();newMovement();}
  function newMovement(){const choices=[['C4','D4','step'],['D4','E4','step'],['E4','F4','step'],['F4','G4','step'],['C4','E4','skip'],['D4','F4','skip'],['E4','G4','skip']];state.pair=choices[Math.floor(Math.random()*choices.length)];cue(state.pair[0],.4,0);cue(state.pair[1],.4,.55);setFeedback('Listen: is that a step or a skip?');}
  function modeGap(){stopAll();state.mode='gap';state.selected=[];clearActive();newGap();}
  function newGap(){const choices=[['E4','F4','semitone'],['B4','C5','semitone'],['C4','C#4','semitone'],['F4','F#4','semitone'],['C4','D4','tone'],['D4','E4','tone'],['F4','G4','tone'],['G4','A4','tone']];state.pair=choices[Math.floor(Math.random()*choices.length)];cue(state.pair[0],.4,0);cue(state.pair[1],.4,.55);setFeedback('Listen: is that gap a tone or a semitone?');}
  function modeTriad(){stopAll();state.mode='triad';state.selected=[];clearActive();setFeedback('Build the C-major tonic triad. Choose exactly three notes.');}
  function handleKey(note,alreadyPlaying=false){
    if(!alreadyPlaying)cue(note,.55);
    if(state.mode==='find'){
      const pitchClass=labelFor(note);const targetClass=labelFor(state.target);
      if(pitchClass===targetClass){setFeedback(`Yes — ${pitchClass}!`,true);setTimeout(newFind,900);}
      else setFeedback(`That is ${pitchClass}. Try again: find ${targetClass}.`);
    }
    if(state.mode==='triad'){
      if(!lowerNaturals.includes(note)||note==='C5')return;
      const i=state.selected.indexOf(note);if(i>=0)state.selected.splice(i,1);else if(state.selected.length<3)state.selected.push(note);
      document.querySelectorAll('.music-key').forEach(k=>k.classList.toggle('selected',state.selected.includes(k.dataset.note)));
      setFeedback(state.selected.length<3?`Choose ${3-state.selected.length} more note${state.selected.length===2?'':'s'}.`:'Now press “Check C–E–G”.');
    }
  }
  function answerMovement(answer){if(state.mode!=='movement'||!state.pair)return;const ok=answer===state.pair[2];setFeedback(ok?`Correct — ${labelFor(state.pair[0])} to ${labelFor(state.pair[1])} is a ${answer}.`:'Not quite. Listen again and think: next-door note or jump over one?',ok);if(ok)setTimeout(newMovement,1100);else{cue(state.pair[0],.4,0);cue(state.pair[1],.4,.55);}}
  function answerGap(answer){if(state.mode!=='gap'||!state.pair)return;const ok=answer===state.pair[2];setFeedback(ok?`Correct — that is a ${answer}.`:'Not quite. Listen again: tiny step or bigger whole-tone step?',ok);if(ok)setTimeout(newGap,1100);else{cue(state.pair[0],.4,0);cue(state.pair[1],.4,.55);}}
  function checkTriad(){const names=state.selected.map(labelFor).sort().join(', ');const ok=['C4','E4','G4'].every(n=>state.selected.includes(n))&&state.selected.length===3;if(ok){setFeedback('Yes — C, E and G are 1, 3 and 5: the C-major tonic triad.',true);cue('C4',.9,0);cue('E4',.9,.05);cue('G4',.9,.1);}else setFeedback(`You chose ${names||'no notes yet'}. The home chord needs C, E and G.`);}
  function replayPair(){if(state.pair){cue(state.pair[0],.4,0);cue(state.pair[1],.4,.55);}}
  function setMode(mode){stopAll();document.querySelectorAll('[data-kmode]').forEach(b=>b.classList.toggle('active',b.dataset.kmode===mode));document.querySelectorAll('[data-mode-panel]').forEach(p=>p.hidden=p.dataset.modePanel!==mode);({free:modeFree,find:modeFind,movement:modeMovement,gap:modeGap,triad:modeTriad}[mode]||modeFree)();}
  function setupSoundControls(){
    const slider=document.querySelector('#keyboardVolume'),label=document.querySelector('#keyboardVolumeValue'),pedal=document.querySelector('#sustainToggle');
    if(slider){const saved=Number(localStorage.getItem('music-house-volume'));if(saved)slider.value=String(Math.round(saved*100));const show=()=>{label.textContent=`${Math.round(Number(slider.value))}%`;};show();audio.setVolume(Number(slider.value)/100);slider.addEventListener('input',()=>{show();audio.setVolume(Number(slider.value)/100);});}
    pedal?.addEventListener('change',()=>{if(!pedal.checked){sustained.forEach(id=>audio.stop(id));sustained.clear();}});
  }
  document.addEventListener('DOMContentLoaded',()=>{
    buildKeyboard();setupPointerPlaying();setupSoundControls();setupFullscreen();
    document.querySelectorAll('[data-kmode]').forEach(b=>b.addEventListener('click',()=>setMode(b.dataset.kmode)));
    document.querySelectorAll('[data-movement-answer]').forEach(b=>b.addEventListener('click',()=>answerMovement(b.dataset.movementAnswer)));
    document.querySelectorAll('[data-gap-answer]').forEach(b=>b.addEventListener('click',()=>answerGap(b.dataset.gapAnswer)));
    document.querySelectorAll('[data-replay]').forEach(b=>b.addEventListener('click',replayPair));
    document.querySelector('#checkTriad')?.addEventListener('click',checkTriad);
    document.querySelector('#clearTriad')?.addEventListener('click',modeTriad);
    if(rangeMedia?.addEventListener)rangeMedia.addEventListener('change',buildKeyboard);else rangeMedia?.addListener?.(buildKeyboard);
    document.addEventListener('visibilitychange',()=>{if(document.hidden)stopAll();});
    setMode('free');
  });
})();
